# === Railway Environment Variables ===
# Copy these into Railway → Variables and fill in the values

# Telegram Bot Token (از @BotFather)
BOT_TOKEN=توکن_ربات

# Admin Telegram User ID (آیدی عددی خودت)
ADMIN_ID=توکن_عددی_ادمین

# Default panel credentials (اختیاری — اگه از منوی ادمین پنل اضافه کنی، لازم نیست)
PANEL_URL=
PANEL_USERNAME=
PANEL_PASSWORD=

# Channel username (بدون @)
CHANNEL_USERNAME=

# Card info for payments
CARD_NUMBER=
CARD_OWNER=

# Database path (این رو تغییر نده - به Volume اشاره می‌کنه)
DB_PATH=/data/bot.db
